# GhostOps Backend Environment Variables
# Copy to .env and fill in values

# ── REQUIRED ──────────────────────────────────────────
# Strong random secret for JWT signing (run: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Admin account email (this user gets is_admin=1 auto-promoted on first login)
ADMIN_EMAIL=admin@ghostops.io

# ── OPTIONAL ──────────────────────────────────────────
# Comma-separated list of allowed CORS origins (default: localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000,https://ghostops.io

# SQLite database file path (default: ghostops.db in working directory)
# DB_FILE=ghostops.db
